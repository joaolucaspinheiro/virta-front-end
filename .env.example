# Google OAuth Client ID.
# Where to get it: Google Cloud Console > APIs & Services > Credentials >
# "Create credentials" > OAuth 2.0 Client ID > Type: Web application.
# Under "Authorized JavaScript origins" add: http://localhost:5173
# Copy this file to .env.local and paste the value below.
VITE_GOOGLE_CLIENT_ID=

# Backend URL (production only, no trailing slash), e.g. https://virta-back-end.onrender.com
# Leave empty in local development: the Vite proxy forwards /auth and /api to localhost:8080.
VITE_API_URL=
